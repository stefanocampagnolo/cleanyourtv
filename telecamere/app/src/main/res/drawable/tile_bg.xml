<?xml version="1.0" encoding="utf-8"?>
<!-- bordo visibile solo sul riquadro selezionato col telecomando -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#000000" /><stroke android:width="4dp" android:color="#FFC107" /></shape>
    </item>
    <item>
        <shape><solid android:color="#000000" /><stroke android:width="1dp" android:color="#222222" /></shape>
    </item>
</selector>
